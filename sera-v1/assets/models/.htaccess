# 3D model: right type, compressed on the wire, cached for a year (the URL carries the theme version).
<IfModule mod_mime.c>
  AddType model/gltf-binary .glb
</IfModule>
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE model/gltf-binary
</IfModule>
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType model/gltf-binary "access plus 1 year"
</IfModule>
<IfModule mod_headers.c>
  Header set Cache-Control "public, max-age=31536000, immutable"
</IfModule>
